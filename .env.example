# --- Phase 1: local Emulator testing (no real credentials needed) ---
# Set to true for anonymous local testing. Remove/unset once real Teams
# credentials below are in use.
DANGEROUSLY_ALLOW_UNAUTHENTICATED_REQUESTS=false

# --- Phase 2: real Teams integration (fill in once Azure Bot is created) ---
# Never commit a real .env with actual values — this file is a template only.

# Entra ID app (client) ID from the Azure Bot resource's app registration.
MICROSOFT_APP_ID=

# Client secret generated on that app registration.
MICROSOFT_APP_PASSWORD=

# Tenant ID of the Azure AD tenant the app is registered in
# (your student subscription's tenant, not necessarily your org's Teams tenant).
MICROSOFT_APP_TENANT_ID=

# Single-tenant app — matches MICROSOFT_APP_TENANT_ID.
MICROSOFT_APP_TYPE=SingleTenant
