[flake8]
max-line-length = 100
extend-ignore = E203,E501,W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg-info,
    dist,
    build,
    .pytest_cache,
    .mypy_cache,
    htmlcov
per-file-ignores =
    __init__.py:F401,F403
    tests/*:D100,D101,D102,D103,D104
docstring-convention = google
max-complexity = 10
import-order-style = google
application-import-names = src
show-source = True
statistics = True
count = True
